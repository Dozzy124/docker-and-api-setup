APP_NAME="Medical AI Assistant API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# API-only: no Blade views, no session UI
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=medai
DB_USERNAME=medai
DB_PASSWORD=secret
DB_FORWARD_PORT=5432

# -----------------------------------------------------------------------
# Redis — cache, queues (Horizon), broadcasting
# -----------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379
REDIS_CLIENT=phpredis

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# -----------------------------------------------------------------------
# Sanctum — SPA (Next.js) session-cookie auth
# Root-domain cookie sharing must be configured before deploy (see ТЗ §3.2)
# -----------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,app.project.md
SESSION_DOMAIN=.project.md

# -----------------------------------------------------------------------
# CORS — Next.js (web) origin must be whitelisted for the SPA cookie flow
# -----------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------
# Mail — local Mailhog SMTP (register / reset-password flows)
# -----------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@medai.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------
# Laravel Horizon
# -----------------------------------------------------------------------
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# -----------------------------------------------------------------------
# Laravel Reverb — WebSockets (real-time notifications, §5)
# -----------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=medai
REVERB_APP_KEY=medai-key
REVERB_APP_SECRET=medai-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# -----------------------------------------------------------------------
# Object storage — S3-compatible / self-hosted MinIO (documents §2)
# -----------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=medai-documents
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
